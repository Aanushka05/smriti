# =========================================================
# SmritiSaathi Care — backend environment configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file or put these values in
# any frontend file (index.html, app.js, chat.js, etc).
# =========================================================

# ---- Server ----
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
# How long a login stays valid (default 12h). Examples: 30m, 12h, 7d
JWT_TTL=12h

# ---- Bhashini (https://bhashini.gov.in/ , dashboard: https://bhashini.gov.in/ulca/user/login) ----
# 1. Register as an integrator at https://bhashini.gov.in/ulca/user/register
# 2. Log in, open "My Profile", generate a User ID + API Key (ulcaApiKey).
# 3. These two values authenticate the Pipeline CONFIG call only.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# 4. Pick a pipeline ID that supports the "translation" task (and "asr"/"tts"
#    if you want speech). You can use the public general-purpose pipeline
#    below to start, or fetch your own via the Pipeline Search Call.
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# 5. These two are looked up automatically the first time the backend calls
#    Bhashini (via the Pipeline Config Call) and cached in memory — you do
#    NOT need to set them by hand. They're listed here only so you know
#    they exist and can override them if your integrator account needs a
#    fixed inference endpoint.
# BHASHINI_INFERENCE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
# BHASHINI_INFERENCE_API_KEY_NAME=Authorization
# BHASHINI_INFERENCE_API_KEY_VALUE=

# ---- Chat (Claude via Anthropic API) ----
# Used by backend/chat_service.js to generate the assistant's reply, which
# is then routed through Bhashini for translation to the patient's language.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Timeouts (optional) ----
# How long to wait for Bhashini before falling back to English (default 15s).
BHASHINI_TIMEOUT_MS=15000
# How long to wait for the AI write-up before showing the built-in analysis
# on its own (default 25s).
AI_TIMEOUT_MS=25000

# ---- Development seed data (optional) ----
# Set to false to start with a completely empty database — no demo
# patients, no demo caregiver. Everything in the app still works.
SEED_DEMO_DATA=true

# ---- Missed-dose SMS alerts to caregivers ----
# A web browser CANNOT send an SMS. Alerts are always sent by this backend.
# Pick ONE provider:
#
#   console : development only. The message is printed to the server log
#             and is NOT delivered to anyone. This is the default.
#   http    : an internet SMS gateway (Twilio, MSG91, Gupshup, a state
#             gateway). Needs the SERVER to have internet; the patient's
#             device does not.
#   gsm     : a GSM/LTE modem on a serial port. The ONLY option that works
#             with no internet at all — it needs cellular coverage instead.
#             Also run: npm install serialport
SMS_PROVIDER=console

# Sender ID / phone number shown to the caregiver (where the provider allows it).
SMS_FROM=SMRITI

# ---- http provider ----
# {{to}}, {{from}} and {{text}} are substituted before sending.
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_BODY={"to":"{{to}}","from":"{{from}}","message":"{{text}}"}
SMS_HTTP_TIMEOUT_MS=15000

# ---- gsm provider ----
# Linux/macOS: /dev/ttyUSB0 or /dev/tty.usbserial-XXXX
# Windows:     COM3, COM4, ...
SMS_GSM_PORT=
SMS_GSM_BAUD=115200
SMS_GSM_TIMEOUT_MS=20000

# ---- Retry behaviour (optional) ----
# Attempts per alert before it is marked failed and shown on the caregiver
# dashboard for manual follow-up. An alert is never sent twice: the alert ID
# is the idempotency key.
SMS_MAX_ATTEMPTS=5
SMS_RETRY_BASE_MS=60000

# =========================================================
# Second-factor login (MFA/OTP)
# =========================================================
# Both patients and caregivers get a 6-digit code after their password.
# ON by default. Turning it off is a deliberate act and is logged at startup.
MFA_ENABLED=true

# How the code behaves. The defaults are sensible; override only with reason.
OTP_TTL_MS=300000              # 5 minutes
OTP_MAX_ATTEMPTS=5             # wrong guesses before the challenge locks
OTP_MAX_RESENDS=3              # new codes per challenge
OTP_RESEND_COOLDOWN_MS=30000   # wait between resends
OTP_WINDOW_MS=900000           # rate-limit window per account (15 min)
OTP_MAX_PER_WINDOW=6           # codes an account may request in that window

# DEVELOPMENT ONLY. Returns the code in the login response so the test suite
# can complete the flow with no SMS gateway. It is IGNORED when
# NODE_ENV=production, so it cannot weaken a real deployment. Never set this
# on a server real patients use.
OTP_DEV_ECHO=true

# Codes are delivered over SMS using the SMS_PROVIDER settings above. With
# SMS_PROVIDER=console the code is printed to the server log and delivered to
# nobody — fine for development, useless in production.

# =========================================================
# Caregiver verification documents
# =========================================================
# Where uploaded proof-of-identity files are stored. MUST stay outside the
# frontend directory: everything under frontend/ is served publicly.
# Defaults to backend/private_uploads (git-ignored).
# UPLOAD_DIR=/var/lib/smritisaathi/uploads
UPLOAD_MAX_BYTES=5242880       # 5 MB. JPG, PNG and PDF only.

# =========================================================
# Bhashini speech (translation settings are above)
# =========================================================
# Speech calls carry audio and take longer than a text translation.
BHASHINI_SPEECH_TIMEOUT_MS=30000
BHASHINI_MAX_AUDIO_BYTES=5242880

# NOTE ON CAPABILITY. Bhashini supports different languages for translation,
# speech-to-text and text-to-speech, and which ones depends on the pipeline
# your account is given. The app therefore ASKS the pipeline at runtime
# (GET /api/speech/capability?lang=as) rather than assuming. With no
# credentials every online capability reports false, and the UI hides the
# features rather than offering buttons that cannot work.

# =========================================================
# Companion chat provider
# =========================================================
# Which model answers the in-app companion. The endpoint, key and model name
# are configuration — nothing is hard-coded — so switching provider is an .env
# change rather than a code change.
#
#   kiwi       Kiwi AI. Fill in the three values below from Kiwi's own
#              official documentation. NOTHING is guessed here on purpose:
#              a hard-coded endpoint that turns out to be wrong produces code
#              that looks finished and fails in production.
#   anthropic  Claude, via ANTHROPIC_API_KEY above.
CHAT_PROVIDER=kiwi

KIWI_API_URL=https://api.llm.kiwi/v1/chat/completions
KIWI_API_KEY=sk_kiwi_qbv8LaIS2Fjw7qjrRkpbgq5lBcYJf1hZSXFQHNVNp-0
KIWI_MODEL=auto
KIWI_API_STYLE=openai

CHAT_TIMEOUT_MS=30000
CHAT_MAX_TOKENS=400


CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=15

# =========================================================
# Security
# =========================================================
# Origins allowed to call this API. EMPTY = same-origin only, which is right
# when this server also serves the frontend. Only list origins when the
# frontend is genuinely hosted elsewhere.
CORS_ORIGINS=

# Set to true ONLY when a reverse proxy sits in front, so x-forwarded-for can
# be trusted. Otherwise a client can spoof its own address past the throttle.
TRUST_PROXY=false

# Login throttling. Two tiers: tight per account (stops guessing one
# password), loose per connection (stops spraying across many accounts, while
# not locking out a whole clinic behind one address).
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX_ACCOUNT=12
AUTH_RATE_MAX=300

# JWT_SECRET is REQUIRED in production and must be at least 32 random
# characters — the server refuses to start otherwise.
