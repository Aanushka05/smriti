# =========================================================
# SmritiSaathi Care — backend environment configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file or put these values in
# any frontend file (index.html, app.js, chat.js, etc).
# =========================================================

# ---- Server ----
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
# How long a login stays valid (default 12h). Examples: 30m, 12h, 7d
JWT_TTL=12h

# ---- Bhashini (https://bhashini.gov.in/ , dashboard: https://bhashini.gov.in/ulca/user/login) ----
# 1. Register as an integrator at https://bhashini.gov.in/ulca/user/register
# 2. Log in, open "My Profile", generate a User ID + API Key (ulcaApiKey).
# 3. These two values authenticate the Pipeline CONFIG call only.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# 4. Pick a pipeline ID that supports the "translation" task (and "asr"/"tts"
#    if you want speech). You can use the public general-purpose pipeline
#    below to start, or fetch your own via the Pipeline Search Call.
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# 5. These two are looked up automatically the first time the backend calls
#    Bhashini (via the Pipeline Config Call) and cached in memory — you do
#    NOT need to set them by hand. They're listed here only so you know
#    they exist and can override them if your integrator account needs a
#    fixed inference endpoint.
# BHASHINI_INFERENCE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
# BHASHINI_INFERENCE_API_KEY_NAME=Authorization
# BHASHINI_INFERENCE_API_KEY_VALUE=

# ---- Chat (Claude via Anthropic API) ----
# Used by backend/chat_service.js to generate the assistant's reply, which
# is then routed through Bhashini for translation to the patient's language.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Timeouts (optional) ----
# How long to wait for Bhashini before falling back to English (default 15s).
BHASHINI_TIMEOUT_MS=15000
# How long to wait for the AI write-up before showing the built-in analysis
# on its own (default 25s).
AI_TIMEOUT_MS=25000

# ---- Development seed data (optional) ----
# Set to false to start with a completely empty database — no demo
# patients, no demo caregiver. Everything in the app still works.
SEED_DEMO_DATA=true
